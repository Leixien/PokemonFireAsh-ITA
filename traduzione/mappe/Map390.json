 {
  "id": "\\bGoh: Hey \\PN.",
  "en": "\\bGoh: Hey \\PN.",
  "it": "\\bGoh: Ehi, \\PN."
 },
 {
  "id": "\\bGoh: Hey \\PN. I've been crazy busy catching as many Pokémon as I can. I recently got a Heracross from Kricketina Kylie at the trade event.",
  "en": "\\bGoh: Hey \\PN. I've been crazy busy catching as many Pokémon as I can. I recently got a Heracross from Kricketina Kylie at the trade event.",
  "it": "\\bGoh: Ehi, \\PN. Sono stato impegnatissimo a catturare più Pokémon possibile. Di recente ho ottenuto un Heracross da Kricketina Kylie all'evento di scambio."
 },
 {
  "id": "\\bYou want to see them in battle? I suppose we can do that.",
  "en": "\\bYou want to see them in battle? I suppose we can do that.",
  "it": "\\bVuoi vederli in lotta? Direi che si può fare."
 },
 {
  "id": "Rotom Phone: Announcement. New opponent found for the World Coronation Series. Bea, located in Saffron City Fighting Dojo, is ready for battle.",
  "en": "Rotom Phone: Announcement. New opponent found for the World Coronation Series. Bea, located in Saffron City Fighting Dojo, is ready for battle.",
  "it": "Rotom Phone: Annuncio. Nuovo avversario trovato per le World Coronation Series. Fabia, al Dojo Karate di Zafferanopoli, è pronta a lottare."
 },
 {
  "id": "\\bGoh: Hey \\PN. I've been thinking about Project Mew and I think I need to get stronger. Could you help me with that?",
  "en": "\\bGoh: Hey \\PN. I've been thinking about Project Mew and I think I need to get stronger. Could you help me with that?",
  "it": "\\bGoh: Ehi, \\PN. Ho pensato al Progetto Mew e credo di dover diventare più forte. Potresti aiutarmi?"
 },
 {
  "id": "Rotom Phone: Announcement. New scheduled match for the World Coronation Series. The match will take place in the Sunnyshore Gym against Volkner.",
  "en": "Rotom Phone: Announcement. New scheduled match for the World Coronation Series. The match will take place in the Sunnyshore Gym against Volkner.",
  "it": "Rotom Phone: Annuncio. Nuovo incontro in programma per le World Coronation Series. L'incontro si terrà nella Palestra di Arenipoli contro Corrado."
 },
 {
  "id": "\\bGoh: I know you're about to go into the Masters Eight. I'm not the strongest Trainer, but I figured any help would be useful. So... let's have a battle.",
  "en": "\\bGoh: I know you're about to go into the Masters Eight. I'm not the strongest Trainer, but I figured any help would be useful. So... let's have a battle.",
  "it": "\\bGoh: So che stai per entrare nei Masters Eight. Non sono l'Allenatore più forte, ma ho pensato che qualsiasi aiuto potesse esserti utile. Quindi... lottiamo."
 },
 {
  "id": "Rotom Phone: Announcment. The Masters Eight Tournament is ready to begin. Please head to Wyndon Stadium.",
  "en": "Rotom Phone: Announcment. The Masters Eight Tournament is ready to begin. Please head to Wyndon Stadium.",
  "it": "Smart Rotom: Annuncio. Il Torneo dei Masters Eight sta per iniziare. Recati allo Stadio di Wyndon."
 },
 {
  "id": "\\bGoh: Well, I guess it's time. I'll be in the stands rooting for you.",
  "en": "\\bGoh: Well, I guess it's time. I'll be in the stands rooting for you.",
  "it": "\\bGoh: Beh, direi che è ora. Sarò sugli spalti a fare il tifo per te."
 },
 {
  "id": "\\bGoh: Hey \\PN. I'm still catching as many Pokémon as I can. Knowing you, you want to battle some of them.",
  "en": "\\bGoh: Hey \\PN. I'm still catching as many Pokémon as I can. Knowing you, you want to battle some of them.",
  "it": "\\bGoh: Ehi, \\PN. Sto ancora catturando più Pokémon possibile. Conoscendoti, vorrai lottare contro alcuni di loro."
 },
 {
  "id": "Battle?\\ch[1,1,Main,Bug,Water,Kanto,Johto,Hoenn, Sinnoh,Unova,Kalos,Alola,Galar,Legend]",
  "en": "Battle?\\ch[1,1,Main,Bug,Water,Kanto,Johto,Hoenn, Sinnoh,Unova,Kalos,Alola,Galar,Legend]",
  "it": "Lotta?\\ch[1,1,Principale,Coleottero,Acqua,Kanto,Johto,Hoenn, Sinnoh,Unima,Kalos,Alola,Galar,Leggendari]"
 },
 {
  "id": "\\bGoh: I'm going to catch more and more Pokémon.",
  "en": "\\bGoh: I'm going to catch more and more Pokémon.",
  "it": "\\bGoh: Catturerò sempre più Pokémon."
 },
